{
  "name": "@walkcroach/desktop-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WalkCroach Desktop Phase B — HostAdapter + agent session runner (Node). Consumed by fork electron-main / local verify.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:bundle": "node scripts/bundle-engine.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@walkcroach/agent-engine": "file:../../../walkcroach/packages/agent-engine",
    "@walkcroach/sdk": "file:../../../walkcroach/packages/sdk"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.9",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
