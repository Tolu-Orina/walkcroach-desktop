{
  "name": "walkcroach-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "WalkCroach Desktop — production-grade Code OSS fork (unsigned preview Windows portable)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "verify:fast": "node scripts/verify.mjs --fast",
    "apply:product": "node scripts/apply-product.mjs",
    "audit:product": "node scripts/audit-product-json.mjs",
    "audit:recommendations": "node scripts/audit-recommendations.mjs",
    "audit:incompatibles": "node scripts/audit-incompatibles.mjs",
    "audit:release-notes": "node scripts/audit-release-notes.mjs",
    "audit:surface-area": "node scripts/audit-surface-area.mjs",
    "cadence:kpi": "node scripts/cadence-kpi.mjs",
    "sync:upstream": "bash scripts/sync-upstream.sh",
    "sync:upstream:dry": "bash scripts/sync-upstream.sh --dry-run",
    "package:crash-lambda": "node scripts/package-crash-lambda.mjs",
    "package:engine-bundle": "node scripts/package-engine-bundle.mjs",
    "package:windows-portable": "node scripts/package-windows-portable.mjs",
    "size:census": "node scripts/size-census.mjs",
    "trim:package": "node scripts/trim-package.mjs",
    "clean:package": "node scripts/clean-package.mjs",
    "publish:desktop-cdn": "node scripts/publish-desktop-cdn.mjs",
    "inject:packaged-assets": "node scripts/inject-walkcroach-packaged-assets.mjs",
    "release:windows-portable": "node scripts/release-windows-portable.mjs",
    "test:desktop-agent": "npm test --prefix packages/desktop-agent",
    "test:crash-lambda": "node --test infra/desktop-crash/codes/test.mjs",
    "compile": "npm run compile --prefix vscode",
    "launch": "npm run watch --prefix vscode"
  }
}
